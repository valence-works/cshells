<Project>
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- Ship XML docs in the packages so consumers get the API contract in IntelliSense
             instead of having to decompile. See issue #130.
             CS1591 (missing doc on a public member) is suppressed rather than gated: 47 members
             are still undocumented, and every member that *is* documented ships regardless. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- Central base version for all packages; preview builds will append a suffix like -preview.{runNumber} -->
        <Version>0.0.30</Version>

        <!-- NuGet Package Metadata -->
        <Authors>Sipke Schoorstra</Authors>
        <Company>Valence Works</Company>
        <Copyright>Copyright (c) 2025 Valence Works</Copyright>
        <Description>A lightweight shell &amp; feature system for .NET projects that lets you build modular and multi-tenant apps with per-shell DI containers and config-driven features.</Description>
        <PackageProjectUrl>https://github.com/valence-works/cshells</PackageProjectUrl>
        <RepositoryUrl>https://github.com/valence-works/cshells</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>shell;feature;modular;multitenant;aspnetcore;dependency-injection</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo.png</PackageIcon>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

        <!-- Source Link / symbol packages -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!-- Include project-specific README.md and the shared logo for NuGet packages.
         Note: this file shadows the repo-root Directory.Build.props (MSBuild imports only the
         nearest one), so the logo item has to be repeated here rather than inherited. -->
    <ItemGroup>
        <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />
        <None Include="$(MSBuildThisFileDirectory)..\branding\logo.png" Pack="true" PackagePath="\" Link="logo.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations"/>
    </ItemGroup>

</Project>