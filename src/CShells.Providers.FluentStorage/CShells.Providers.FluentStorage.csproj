<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>FluentStorage integration provider for CShells. Enables loading and persisting shell configurations from various storage backends (Azure Blob, AWS S3, disk, memory, etc.) supported by FluentStorage.</Description>
    <PackageTags>multi-tenancy;tenancy;shell;tenant;storage;fluent-storage;configuration;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentStorage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CShells\CShells.csproj" />
  </ItemGroup>

</Project>
